extends layout

block content
  section.page
    .content-surface.wide
      h1.section-title Open Source

      .projects-grid
        article.project-card
          h3.project-title good2go (okf-bootstrap)
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="okf-bootstrap", data-src="/images/portfolio/okf-bootstrap-viewer.png", data-caption="good2go — the OKF viewer, with the concept graph and a Mermaid diagram")
              img.project-image(src="/images/portfolio/okf-bootstrap-viewer.png", alt="The OKF viewer: a graph of the bundle's concepts on the left, and the Architecture concept open on the right with a Mermaid diagram", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption Viewer &mdash; #[button.project-gallery-more(type="button", data-gallery-open="okf-bootstrap") click to see 2 more screenshots]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="okf-bootstrap", data-src="/images/portfolio/okf-bootstrap-search.png", data-caption="good2go — ranked search with a live preview")
                img.project-image(src="/images/portfolio/okf-bootstrap-search.png", alt="The search modal over the viewer, with ranked results, trust and freshness badges, and a preview of the top result", loading="lazy")
              .project-image-wrapper(data-modal-image, data-gallery="okf-bootstrap", data-src="/images/portfolio/okf-bootstrap-widget.png", data-caption="good2go — an interactive explainer widget")
                img.project-image(src="/images/portfolio/okf-bootstrap-widget.png", alt="A retry widget with no jitter: five thin spikes of 100 retries at once, showing the thundering herd problem", loading="lazy")
          p.project-description
            | Open-source agent skills that set up design docs your agents write and your team can
            | actually follow &mdash; plus a memory the agents keep for themselves. Works with
            | any agent.
          details.tech-details
            summary Technical Details
            p
              | Scaffolds two OKF (Open Knowledge Format) bundles in any project. &lsquo;design/&rsquo;
              | holds plain-markdown design docs, checked by a validator and rendered into one
              | self-contained HTML viewer with a concept graph, ranked search, and interactive
              | explainers &mdash; quizzes and React widgets you can poke at. Mermaid diagrams are
              | parsed and then rendered in headless Chromium as a quality gate. &lsquo;edukai/&rsquo;
              | is the agent&rsquo;s memory: one-claim lessons pinned to file digests with re-runnable
              | checks, so lessons that stop being true get flagged. Published to npm with provenance.
          .project-links
            a.btn(href=`${githubUrl}/okf-bootstrap`, target="_blank", rel="noopener noreferrer") GitHub
          .tech-stack
            span.tag TypeScript
            span.tag Node.js
            span.tag OKF
            span.tag Mermaid
            span.tag React
            span.tag Playwright
            span.tag Claude Code

      h2.section-title.section-title--pad-top Professional &amp; Client Work
      p.page-intro
        | Software I&rsquo;ve built and shipped for clients. The repos are private, so no
        | GitHub link here &mdash; just what each project does, how it&rsquo;s built, and the
        | problem it solved.

      .projects-grid
        article.project-card
          h3.project-title Odoo AI Assistant
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="odoo-ai-assistant", data-src="/images/portfolio/odoo-ai-assistant-chat.png", data-caption="Odoo AI Assistant — chat example")
              img.project-image(src="/images/portfolio/odoo-ai-assistant-chat.png", alt="Odoo AI Assistant chat example", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption Chat &mdash; #[button.project-gallery-more(type="button", data-gallery-open="odoo-ai-assistant") click to see 1 more screenshot]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="odoo-ai-assistant", data-src="/images/portfolio/odoo-ai-assistant-architecture.png", data-caption="Odoo AI Assistant — architecture")
                img.project-image(src="/images/portfolio/odoo-ai-assistant-architecture.png", alt="Odoo AI Assistant architecture diagram", loading="lazy")
          p.project-description
            | An AI chat assistant inside Odoo. Ask plain-English questions about sales, stock,
            | or CRM data and get answers back &mdash; charts included &mdash; without writing a query.
          details.tech-details
            summary Technical Details
            p
              | Built as an Odoo 17 addon. A question gets saved as &lsquo;pending&rsquo; so the request
              | returns fast, then a cron worker wakes immediately via &lsquo;pg_notify&rsquo;, runs the
              | actual Claude tool-use loop, and pushes the answer back over Odoo&rsquo;s bus channel
              | &mdash; no polling. The agent runs under the requesting user&rsquo;s own permissions
              | with five read-only ORM tools plus a sixth &lsquo;render_chart&rsquo; tool: when a chart
              | earns its place, its spec renders client-side through Plotly.js in the OWL chat UI,
              | with every LLM-supplied label sanitised against XSS before it hits the DOM.
              | Per-company blacklists keep the agent off data it shouldn&rsquo;t touch.
          .tech-stack
            span.tag Python
            span.tag Odoo
            span.tag Anthropic API
            span.tag PostgreSQL
            span.tag OWL
            span.tag Plotly.js

        article.project-card
          h3.project-title Odoo Integration Server
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="odoo-integration-server", data-src="/images/portfolio/odoo-integration-server-architecture.png", data-caption="Odoo Integration Server — architecture")
              img.project-image(src="/images/portfolio/odoo-integration-server-architecture.png", alt="Odoo Integration Server architecture diagram", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption Architecture &mdash; #[button.project-gallery-more(type="button", data-gallery-open="odoo-integration-server") click to see 1 more screenshot]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="odoo-integration-server", data-src="/images/portfolio/odoo-integration-server-code.png", data-caption="Odoo Integration Server — swappable real/mock WhatsApp client")
                img.project-image(src="/images/portfolio/odoo-integration-server-code.png", alt="event-queue.ts showing a real vs. mock WhatsApp client swapped at construction time", loading="lazy")
          p.project-description
            | A webhook aggregator that bridges Odoo CRM with the outside world &mdash; website leads,
            | WhatsApp automation, a phone system &mdash; all handled asynchronously.
          details.tech-details
            summary Technical Details
            p
              | A Fastify server queues every inbound webhook through Redis/BullMQ instead of
              | handling it inline, so one slow channel can&rsquo;t take the others down. A worker
              | talks to Odoo over JSON-RPC and sends WhatsApp messages through a swappable
              | client interface, so it&rsquo;s testable without touching a live connection. Runs on
              | Fly.io.
          .tech-stack
            span.tag TypeScript
            span.tag Fastify
            span.tag BullMQ
            span.tag Redis
            span.tag Prisma
            span.tag Fly.io

        article.project-card
          h3.project-title Pitch Deck Generator
          .project-image-wrapper(data-modal-image, data-src="/images/portfolio/pitch-deck-generator-architecture.png", data-caption="Pitch Deck Generator — architecture")
            img.project-image(src="/images/portfolio/pitch-deck-generator-architecture.png", alt="Pitch Deck Generator architecture diagram", loading="lazy")
            span.project-image-badge View full size
          p.project-description
            | An agent-driven pitch deck builder &mdash; Typst source, shared brand templates, Taskfile
            | rendering &mdash; made to run end-to-end by a coding agent, not a human in a slide editor.
          details.tech-details
            summary Technical Details
            p
              | Decks are Typst files that import shared brand and component templates, keeping
              | content and layout separate. A Taskfile drives the build: one task compiles to
              | PDF, another renders every slide to PNG so the agent can check its own layout and
              | fix mistakes itself.
          .tech-stack
            span.tag Typst
            span.tag Taskfile
            span.tag Claude Code

        article.project-card
          h3.project-title ProForma Generator
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="proforma-generator", data-src="/images/portfolio/proforma-generator-intake-form.png", data-caption="ProForma Generator — agent intake form")
              img.project-image(src="/images/portfolio/proforma-generator-intake-form.png", alt="Agent-facing intake form for building an order", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption Intake form &mdash; #[button.project-gallery-more(type="button", data-gallery-open="proforma-generator") click to see 3 more screenshots]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="proforma-generator", data-src="/images/portfolio/proforma-generator-invoice.png", data-caption="ProForma Generator — generated invoice")
                img.project-image(src="/images/portfolio/proforma-generator-invoice.png", alt="Generated pro-forma invoice PDF with branded header, line items, VAT breakdown, and review cards", loading="lazy")
              .project-image-wrapper(data-modal-image, data-gallery="proforma-generator", data-src="/images/portfolio/proforma-generator-architecture.png", data-caption="ProForma Generator — architecture")
                img.project-image(src="/images/portfolio/proforma-generator-architecture.png", alt="ProForma Generator architecture diagram", loading="lazy")
              .project-image-wrapper(data-modal-image, data-gallery="proforma-generator", data-src="/images/portfolio/proforma-generator-code-vat-math.png", data-caption="ProForma Generator — VAT math")
                img.project-image(src="/images/portfolio/proforma-generator-code-vat-math.png", alt="order-processing.ts showing VAT-inclusive/exclusive totals computed with arbitrary-precision decimal math", loading="lazy")
          p.project-description
            | Generates branded, VAT-correct pro-forma invoice PDFs, combining live courier
            | quotes and customer reviews into one document.
          details.tech-details
            summary Technical Details
            p
              | Next.js API routes proxy a courier rate API and a reviews API. A pure
              | business-logic module handles VAT math with arbitrary-precision decimals to
              | avoid floating-point rounding errors, then renders the result to PDF through a
              | React component tree.
          .tech-stack
            span.tag TypeScript
            span.tag Next.js
            span.tag React
            span.tag react-pdf
            span.tag Zod

        article.project-card
          h3.project-title PartsPal
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="partspal", data-src="/images/portfolio/partspal-request-form.png", data-caption="PartsPal — part request form")
              img.project-image(src="/images/portfolio/partspal-request-form.png", alt="Part request submission form with an uploaded photo and vehicle details", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption Request form &mdash; #[button.project-gallery-more(type="button", data-gallery-open="partspal") click to see 3 more screenshots]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="partspal", data-src="/images/portfolio/partspal-quotes.png", data-caption="PartsPal — competing supplier quotes")
                img.project-image(src="/images/portfolio/partspal-quotes.png", alt="Request detail page showing two competing supplier quotes with pricing, condition, and warranty", loading="lazy")
              .project-image-wrapper(data-modal-image, data-gallery="partspal", data-src="/images/portfolio/partspal-architecture.png", data-caption="PartsPal — architecture")
                img.project-image(src="/images/portfolio/partspal-architecture.png", alt="PartsPal architecture diagram", loading="lazy")
              .project-image-wrapper(data-modal-image, data-gallery="partspal", data-src="/images/portfolio/partspal-code-image-processing.png", data-caption="PartsPal — image processing")
                img.project-image(src="/images/portfolio/partspal-code-image-processing.png", alt="image-processing.service.ts showing parallel multi-size WebP resizing and blur-placeholder generation", loading="lazy")
          p.project-description
            | A South African auto-parts marketplace. Customers submit a part request with a
            | photo, suppliers send back competing quotes.
          details.tech-details
            summary Technical Details
            p
              | A module-per-domain NestJS app, server-rendered with Pug and small vanilla-JS Web
              | Components. Photo uploads get resized to multiple sizes with a blur placeholder,
              | and can run through a GPT-4 Vision job to help identify the part before the
              | request&rsquo;s even finished.
          .tech-stack
            span.tag TypeScript
            span.tag NestJS
            span.tag Prisma
            span.tag BullMQ
            span.tag GPT-4 Vision

        article.project-card
          h3.project-title Call Center Node Web Server
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="call-center-web-server", data-src="/images/portfolio/call-center-web-server-dashboard.png", data-caption="Call Center Node Web Server — agent dashboard")
              img.project-image(src="/images/portfolio/call-center-web-server-dashboard.png", alt="Agent dashboard for an active lead, showing dialer buttons, customer and address capture, ID lookup, and policy fields", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption Agent dashboard &mdash; #[button.project-gallery-more(type="button", data-gallery-open="call-center-web-server") click to see 2 more screenshots]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="call-center-web-server", data-src="/images/portfolio/call-center-web-server-architecture.png", data-caption="Call Center Node Web Server — architecture")
                img.project-image(src="/images/portfolio/call-center-web-server-architecture.png", alt="Call Center Node Web Server architecture diagram", loading="lazy")
              .project-image-wrapper(data-modal-image, data-gallery="call-center-web-server", data-src="/images/portfolio/call-center-web-server-code-validation.png", data-caption="Call Center Node Web Server — shared validation logic")
                img.project-image(src="/images/portfolio/call-center-web-server-code-validation.png", alt="validation.ts showing shared South African ID number validation logic used by both client and server", loading="lazy")
          p.project-description
            | A NestJS rebuild of legacy classic-ASP call-center tooling &mdash; campaign management,
            | lead distribution, dialer integration &mdash; migrated module by module instead of a
            | big-bang rewrite.
          details.tech-details
            summary Technical Details
            p
              | Each module follows the same controller/service/repository/guard/DTO pattern,
              | exposing both a JSON API and server-rendered views off the same services. A
              | mocked-services module lets it run locally without a live database, which kept
              | the incremental migration workable day to day.
          .tech-stack
            span.tag TypeScript
            span.tag NestJS
            span.tag MSSQL
            span.tag Pug

      h2.section-title.section-title--pad-top Side Projects

      .projects-grid
        article.project-card
          h3.project-title Pulse Surveys
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="pulse-survey", data-src="/images/portfolio/pulse-summary.png", data-caption="Pulse Surveys — a manager's weekly summary")
              img.project-image(src="/images/portfolio/pulse-summary.png", alt="Weekly summary for the Acme weekly pulse: 50% completion, 2 of 4 members, with a bar per question", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption Weekly summary &mdash; #[button.project-gallery-more(type="button", data-gallery-open="pulse-survey") click to see 2 more screenshots]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="pulse-survey", data-src="/images/portfolio/pulse-member-form.png", data-caption="Pulse Surveys — a member answering this week's questions")
                img.project-image(src="/images/portfolio/pulse-member-form.png", alt="The Blue River weekly pulse form with a 1 to 5 rating, a yes/no question and a second rating", loading="lazy")
              .project-image-wrapper(data-modal-image, data-gallery="pulse-survey", data-src="/images/portfolio/pulse-sign-in.png", data-caption="Pulse Surveys — development sign-in across two organisations")
                img.project-image(src="/images/portfolio/pulse-sign-in.png", alt="Development sign-in listing managers and members for Acme Manufacturing and Blue River Health", loading="lazy")
          p.project-description
            | A weekly check-in tool for teams. Organisations run a short three-question survey,
            | people answer once a week, and managers get a clear summary &mdash; with every
            | organisation&rsquo;s data walled off from every other.
          details.tech-details
            summary Technical Details
            p
              | Tenant isolation is enforced by PostgreSQL itself, not just the app: row-level
              | security policies, and a NestJS API that connects as a role owning nothing, so a
              | forgotten filter in the code still can&rsquo;t leak another organisation&rsquo;s
              | data &mdash; and the isolation tests connect as that role to prove it. The business
              | rules live in the schema too: a fourth question or a half-filled answer simply
              | can&rsquo;t be stored, and &lsquo;one response per person per week&rsquo; is a unique
              | index. One set of Zod schemas is the contract for both the API and the React 19
              | front end. Every decision is written up in an OKF design bundle, alongside a log of
              | how the AI agents were steered and checked.
          .project-links
            a.btn(href=`${githubUrl}/pulse-survey`, target="_blank", rel="noopener noreferrer") GitHub
          .tech-stack
            span.tag TypeScript
            span.tag NestJS
            span.tag PostgreSQL
            span.tag Row-Level Security
            span.tag Drizzle
            span.tag React
            span.tag Zod
            span.tag Playwright

        article.project-card
          h3.project-title Product Catalogue Search
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="product-catalog-search", data-src="/images/portfolio/catalog-typeahead.png", data-caption="Product Catalogue Search — typeahead, with one item degraded gracefully")
              img.project-image(src="/images/portfolio/catalog-typeahead.png", alt="Typing 'tra' shows trail shoe suggestions above ranked results, one marked Price unavailable", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption Typeahead &mdash; #[button.project-gallery-more(type="button", data-gallery-open="product-catalog-search") click to see 1 more screenshot]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="product-catalog-search", data-src="/images/portfolio/catalog-results.png", data-caption="Product Catalogue Search — filtered and sorted by price")
                img.project-image(src="/images/portfolio/catalog-results.png", alt="Footwear results sorted by price, each with live price, availability and delivery estimate", loading="lazy")
          p.project-description
            | Shop search that keeps up while you type. Results come back ranked, with live
            | prices, stock and delivery estimates &mdash; and when a supplier has a wobble, the
            | page carries on without it.
          details.tech-details
            summary Technical Details
            p
              | An Express 5 API builds an inverted index at startup, so every search is a lookup
              | rather than a scan: name matches outrank tags, and a prefix fallback catches
              | half-typed words. Only the page you&rsquo;re looking at gets live data, fetched in
              | parallel under a 3-second budget, and a failed lookup degrades that one item, never
              | the whole page. The client is hand-rolled TypeScript with no framework &mdash; keyed
              | DOM diffing, View Transitions, typeahead, and cancellation that runs from the
              | browser right through to the upstream call, so a fast typist never sees stale
              | results.
          .project-links
            a.btn(href=`${githubUrl}/product-catalog-search`, target="_blank", rel="noopener noreferrer") GitHub
          .tech-stack
            span.tag TypeScript
            span.tag Node.js
            span.tag Express
            span.tag Vanilla TS
            span.tag Vite
            span.tag Vitest
            span.tag Playwright

        article.project-card
          h3.project-title Personal Website
          p.project-description
            | You&rsquo;re looking at it! A static site served by Nginx with a tiny Fastify contact
            | endpoint, self-hosted fonts, and a no-flash dark/light theme.
          details.tech-details
            summary Technical Details
            p
              | Pug templates rendered at build time into static HTML. Markdown blog posts with
              | syntax highlighting. Zoho Mail OAuth2 + hCaptcha spam protection behind the
              | contact form. Fully static &mdash; no runtime for pages.
          .project-links
            a.btn(href=`${githubUrl}/jordancolehunt.com`, target="_blank", rel="noopener noreferrer") GitHub
          .tech-stack
            span.tag TypeScript
            span.tag Nginx
            span.tag Fastify
            span.tag Pug
            span.tag Vanilla JS
            span.tag Markdown
            span.tag Zoho Mail

        article.project-card
          h3.project-title Lane Racer #[span.project-status Work in progress]
          p.project-description
            | A retro-style racing game that runs right in your terminal. Four AI drivers compete
            | to dodge obstacles and cross the finish line first. Built twice &mdash; once in
            | JavaScript, once in Python.
          details.tech-details
            summary Technical Details
            p
              | Demonstrates feature parity between ES2020+ JavaScript (private fields, generators,
              | Set.difference) and Python 3.10+ (type hints, pattern matching, dataclasses,
              | protocols). Strategy pattern for AI decision-making with full state serialisation.
          .project-links
            a.btn(href=`${githubUrl}/race-sim`, target="_blank", rel="noopener noreferrer") GitHub
          .tech-stack
            span.tag JavaScript
            span.tag Python
            span.tag Node.js
            span.tag Async/Await
            span.tag Strategy Pattern
            span.tag Terminal UI

        article.project-card
          h3.project-title Dino Park
          .project-image-wrapper(data-modal-image, data-src="/images/portfolio/dino-park-app.png", data-caption="Dino Park — the live park grid, with a dangerous cell selected")
            img.project-image(src="/images/portfolio/dino-park-app.png", alt="Dino Park: park statistics and filters on the left, the 26×16 enclosure grid with two dangerous cells in red, and a details panel for cell A16 showing a hungry Brachiosaurus", loading="lazy")
            span.project-image-badge View full size
          p.project-description
            | Ever wanted to run a dinosaur park without the risk of being eaten? Manage a grid
            | of enclosures, tracking feeding schedules, movements, and maintenance alerts.
          details.tech-details
            summary Technical Details
            p
              | Built with pure functional programming principles in React. Processes real-time
              | events to manage a 26&times;16 park grid using immutable data structures.
          .project-links
            a.btn(href=`${githubUrl}/dino-park`, target="_blank", rel="noopener noreferrer") GitHub
            a.btn(href="https://dino-park.fly.dev/", target="_blank", rel="noopener noreferrer") Live App
          .tech-stack
            span.tag React
            span.tag Vite
            span.tag Vitest
            span.tag Functional Programming

        article.project-card
          h3.project-title SQL Training Environment #[span.project-status Work in progress]
          p.project-description
            | A hands-on SQL training platform for senior engineering interview prep. Work through
            | progressive exercises &mdash; from basic SELECT statements to window functions and CTEs.
          details.tech-details
            summary Technical Details
            p
              | A unified database abstraction layer transparently handles PostgreSQL 9.6, 13, and
              | SQLite through a single interface. Each exercise runs in isolated schemas, with
              | custom Vitest assertions for SQL-specific validation.
          .project-links
            a.btn(href=`${githubUrl}/sql-training`, target="_blank", rel="noopener noreferrer") GitHub
          .tech-stack
            span.tag PostgreSQL
            span.tag SQLite
            span.tag Vitest
            span.tag Docker
            span.tag Node.js

        article.project-card
          h3.project-title okf-browse
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="okf-browse", data-src="/images/portfolio/okf-browse-tui.png", data-caption="okf-browse — exploring the Star Wars example bundle")
              img.project-image(src="/images/portfolio/okf-browse-tui.png", alt="okf-browse TUI showing the Star Wars example bundle, with a live preview on the right", loading="lazy")
              span.project-image-badge View full size
            p.project-gallery-caption TUI &mdash; #[button.project-gallery-more(type="button", data-gallery-open="okf-browse") click to see the code]
            .project-gallery-extra
              .project-image-wrapper(data-modal-image, data-gallery="okf-browse", data-src="/images/portfolio/okf-browse-code.png", data-caption="okf-browse — mermaid to ASCII in the terminal")
                img.project-image(src="/images/portfolio/okf-browse-code.png", alt="render_mermaid_blocks rendering mermaid fenced blocks to ASCII in the terminal, falling back to the raw fence when termaid is unavailable", loading="lazy")
          p.project-description
            | A terminal UI for exploring any OKF knowledge bundle &mdash; browse by tag, document,
            | or full-text body search, with Vim-flavoured navigation and mermaid diagrams rendered
            | to ASCII right in the terminal. Ships with a self-contained conformance validator.
          details.tech-details
            summary Technical Details
            p
              | Built with Textual. Three ways in &mdash; Tags, Documents, and ranked full-text
              | Search &mdash; each a filterable list with a live preview. The viewer is modal like a
              | Vim buffer: `/` searches the current document with match cycling, and `]`/`[` walk
              | links to other concepts. Mermaid fences render to ASCII via termaid at load time,
              | falling back to the raw fence if a diagram won&rsquo;t parse.
          .project-links
            a.btn(href=`${githubUrl}/okf-browse`, target="_blank", rel="noopener noreferrer") GitHub
          .tech-stack
            span.tag Python
            span.tag Textual
            span.tag termaid
            span.tag uv

        article.project-card
          h3.project-title local-ai
          .project-gallery-featured
            .project-image-wrapper(data-modal-image, data-gallery="local-ai", data-src="/images/portfolio/local-ai-code.png", data-caption="local-ai — auto-detecting the hardware profile")
              img.project-image(src="/images/portfolio/local-ai-code.png", alt="selectHardware auto-detecting the active hardware profile by hostname or platform, with an explicit --hw override on top", loading="lazy")
              span.project-image-badge View full size
          p.project-description
            | A config-driven launcher for local LLM inference with llama.cpp &mdash; declare a model
            | once and get the right llama-server command on any host, CPU-only or GPU.
          details.tech-details
            summary Technical Details
            p
              | Plain Node.js with zero npm dependencies. Models carry their own sampling defaults
              | and context presets; hardware profiles live in the same file and are auto-selected by
              | hostname or platform, so one model list drives both an Apple Silicon Mac and a
