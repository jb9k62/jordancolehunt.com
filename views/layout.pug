doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="theme-color", content="#1a2f3d")
    title= title || "Jordan Cole Hunt"

    //- Favicon
    link(rel="icon", type="image/svg+xml", href="/favicon.svg")
    link(rel="alternate icon", href="/favicon.svg")
    link(rel="apple-touch-icon", href="/favicon.svg")
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/transitions.css")
    link(rel="stylesheet", href="/styles/components.css")
    link(rel="preconnect", href="https://fonts.googleapis.com")
    link(rel="preconnect", href="https://fonts.gstatic.com", crossorigin)
    link(href="https://fonts.googleapis.com/css2?family=Space+Grotesk:wght@300;400;500;600;700&display=swap", rel="stylesheet")

    //- Lucide Icons
    script(src="https://unpkg.com/lucide@latest")

  body(data-page=page || "")
    //- Navigation (persistent across all pages)
    include mixins/nav
    +nav(currentPath)

    //- Main content container (animated by View Transitions API)
    main
      block content

    //- Footer (persistent across all pages)
    include mixins/footer
    +footer()

    //- Image lightbox modal (outside <main>, so it isn't trapped by
    //- main's view-transition-name stacking context - see components.css)
    #image-modal.image-modal(role="dialog", aria-modal="true", aria-hidden="true")
      .image-modal-content
        button.image-modal-close(type="button", aria-label="Close image") ×
        img#image-modal-img(src="", alt="")
        p#image-modal-caption.image-modal-caption

    //- Scripts
    script(src="/js/dots-background.js")
    script(src="https://cdn.jsdelivr.net/npm/gsap@3.12.5/dist/gsap.min.js")
    script(src="/js/transitions.js")
    script(src="/js/app.js", type="module")
    script(src="/js/image-modal.js")
    block scripts
