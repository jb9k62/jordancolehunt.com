doctype html
html(lang="en")
  head
    meta(charset="UTF-8")
    meta(name="viewport", content="width=device-width, initial-scale=1.0")
    meta(name="description", content="Jordan Cole Hunt — full-stack software engineer")
    meta(name="theme-color", content="#faf9f6")
    title= title || "Jordan Cole Hunt"

    //- No-flash theme init (before first paint)
    script.
      (function () {
        try {
          var t = null;
          var m = location.search.match(/[?&]theme=([a-z]+)/i);
          if (m) t = m[1];
          if (!t) t = localStorage.getItem('theme');
          if (!t) {
            t = (window.matchMedia && window.matchMedia('(prefers-color-scheme: dark)').matches) ? 'dark' : 'light';
          }
          if (t === 'dark') {
            document.documentElement.setAttribute('data-theme', 'dark');
            // Keep browser chrome in sync before first paint (no light flash in dark mode)
            var tc = document.querySelector('meta[name="theme-color"]');
            if (tc) tc.setAttribute('content', '#2e2d2b');
          }
        } catch (e) {}
      })();

    //- Favicon
    link(rel="icon", type="image/svg+xml", href="/favicon.svg")

    //- Styles (hashed at build time)
    link(rel="stylesheet", href="/styles/main.css")
    link(rel="stylesheet", href="/styles/components.css")
    link(rel="stylesheet", href="/styles/transitions.css")

  body(data-page=page || "")
    //- Navigation (persistent)
    include mixins/nav
    +nav(currentPath)

    //- The header is fixed, and on small screens it wraps to more than one row, so
    //- reserve its actual rendered height to prevent it from overlapping content.
    script.
      (function () {
        function sync() {
          var el = document.querySelector('.site-header');
          if (el) document.documentElement.style.setProperty('--header-h', el.offsetHeight + 'px');
        }
        sync();
        if (window.ResizeObserver) {
          var el = document.querySelector('.site-header');
          if (el) new ResizeObserver(sync).observe(el);
        } else {
          window.addEventListener('resize', sync);
        }
        document.addEventListener('DOMContentLoaded', sync);
      })();

    //- Main content
    main.main
      block content

    //- Footer (persistent)
    include mixins/footer
    +footer()

    //- Image lightbox modal
    #image-modal.image-modal(role="dialog", aria-modal="true", aria-hidden="true")
      .image-modal-content
        button.image-modal-close(type="button", aria-label="Close image") ×
        button.image-modal-nav.image-modal-prev(type="button", aria-label="Previous image") ‹
        img#image-modal-img(src="", alt="")
        button.image-modal-nav.image-modal-next(type="button", aria-label="Next image") ›
        .image-modal-footer
          p#image-modal-caption.image-modal-caption
          p#image-modal-counter.image-modal-counter

    //- Scripts (hashed at build time)
    script(src="/js/app.js")
    script(src="/js/image-modal.js")
    script(src="/js/transitions.js")
    block scripts
