          li Node.js, NestJS &amp; FastAPI
          li PostgreSQL, Redis, SQLite &amp; MSSQL
          li Auth, APIs &amp; Event Queues

      .skill-group
        h2.group-title Infrastructure
        p.group-desc Ship fast, stay stable.
        ul.tick-list
          li Docker &amp; CI/CD
          li AWS, GCP &amp; Fly
          li Git &amp; GitHub Actions
          li Playwright &amp; Jest

      .skill-group
        h2.group-title Specialisations
        p.group-desc Where I go deep.
        ul.tick-list
          li Distributed Systems &amp; Architecture
          li AI Agents &amp; LLMs
          li Odoo Implementation
          li Performance &amp; Scale
