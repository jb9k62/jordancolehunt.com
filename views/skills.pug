      .skill-group
        h2.group-title Frontend
        p.group-desc Pixel-perfect, performant interfaces.
        ul.tick-list
          li TypeScript, HTML5 &amp; CSS3
          li React &amp; Next.js
          li Responsive Design
          li Browser APIs &amp; Web Performance

      .skill-group
