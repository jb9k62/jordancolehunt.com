extends layout

block content
  section.skills
    .container
      h1.section-title What I Work With

      .skills-grid
        .skill-category
          h3 Frontend
          p.skill-description Pixel-perfect, performant interfaces.
          ul.tech-list
            li TypeScript, HTML5 & CSS3
            li React & Next.js
            li Responsive Design
            li Browser APIs & Web Performance

        .skill-category
          h3 Backend
          p.skill-description Scalable systems that stay up.
          ul.tech-list
            li TypeScript & Python
            li Node.js, NestJS & FastAPI
            li PostgreSQL, Redis, SQLite & MSSQL
            li Auth, APIs & Event Queues

        .skill-category
          h3 Infrastructure
          p.skill-description Ship fast, stay stable.
          ul.tech-list
            li Docker & CI/CD
            li AWS, GCP & Fly
            li Git & GitHub Actions
            li Playwright & Jest

        .skill-category
          h3 Specialisations
          p.skill-description Where I go deep.
          ul.tech-list
            li Distributed Systems & Architecture
            li AI Agents & LLMs
            li Odoo Implementation
            li Performance & Scale
