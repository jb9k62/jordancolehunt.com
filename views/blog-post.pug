extends layout

block content
  article.blog-post
    .content-surface
      header.post-header
        a.back-link(href="/blog") ← Back to Blog

        h1.post-title= post.title

        - const fmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
        p.post-meta= `${fmt(post.date)} — ${post.author}`

        if post.tags && post.tags.length > 0
          .tags
            each tag in post.tags
              span.tag= tag

      //- Rendered + sanitised at build time (DOMPurify)
      .post-content
        != post.html

      footer.post-footer
        a.back-link(href="/blog") ← Back to Blog
