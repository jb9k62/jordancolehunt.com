extends layout

block content
  section.page
    .content-surface
      h1.section-title Blog &amp; Media

      if posts && posts.length > 0
        - const fmt = (d) => new Date(d).toLocaleDateString('en-GB', { day: 'numeric', month: 'short', year: 'numeric' });
        .post-list
          each post in posts
            article.post-entry
              h2.post-title
                a(href=`/blog/${post.slug}`)= post.title
              p.post-meta= fmt(post.date)
              p.post-excerpt= post.excerpt
              if post.tags && post.tags.length > 0
                .tags
                  each tag in post.tags
                    span.tag= tag
      else
        p.page-intro No blog posts yet. Check back soon for updates!
