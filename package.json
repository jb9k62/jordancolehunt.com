{
  "name": "jordancolehunt-v2",
  "version": "3.0.0",
  "description": "Personal website — static site (Nginx) with a tiny Fastify contact endpoint",
  "scripts": {
    "build": "npm run build:static && npm run build:server",
    "build:static": "tsx scripts/build.ts",
    "build:server": "tsc -p tsconfig.server.json",
    "start": "node dist-server/server.js",
    "dev": "npm run build:static && tsx watch src/server.ts",
    "preview": "tsx scripts/preview.ts",
    "selfcheck": "tsx scripts/lib/blog.selfcheck.ts"
  },
  "dependencies": {
    "@fastify/cors": "^8.5.0",
    "dotenv": "^16.3.1",
    "fastify": "^5.8.5",
    "hcaptcha": "^0.2.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "gray-matter": "^4.0.3",
    "highlight.js": "^11.11.1",
    "isomorphic-dompurify": "^2.30.1",
    "marked": "^16.4.1",
    "pug": "^3.0.3",
    "tsx": "^4.19.0",
    "typescript": "^5.3.3"
  }
}
